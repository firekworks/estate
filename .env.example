# Browser-safe Supabase values. RLS remains the security boundary.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-only AI. Never prefix these with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_ESTATE_MODEL=gpt-5.6-luna
OPENAI_ESTATE_RESEARCH_MODEL=gpt-5.6-luna
OPENAI_ESTATE_VISION_MODEL=gpt-5.6-luna

# Optional licensed / official real-estate data connectors.
IDEALISTA_API_KEY=
IDEALISTA_API_SECRET=
IDEALISTA_DATA_API_KEY=
PISOS_API_KEY=
INMOVILLA_TOKEN=
INMOVILLA_FEED_URL=
GOOGLE_MAPS_API_KEY=

# Never add SUPABASE_SERVICE_ROLE_KEY or sb_secret_* to NEXT_PUBLIC_* variables.
